# Stage 1: dependensi PHP
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --optimize --no-dev

# Stage 2: build frontend (client + SSR)
FROM node:22 AS frontend
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

# Stage 3: image PHP final
FROM php:8.3-fpm AS app
RUN apt-get update && apt-get install -y \
    libzip-dev libpng-dev libjpeg-dev libfreetype6-dev libonig-dev \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install pdo_mysql mbstring zip gd bcmath exif pcntl opcache \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html
COPY --from=vendor /app /var/www/html
COPY --from=frontend /app/public/build /var/www/html/public/build
COPY --from=frontend /app/bootstrap/ssr /var/www/html/bootstrap/ssr
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
 && chown -R www-data:www-data storage bootstrap/cache
USER www-data

# Stage 4: Nginx yang membawa file statis
FROM nginx:alpine AS web
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

# Stage 5: server SSR (Node)
FROM node:22 AS ssr
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=frontend /app/bootstrap/ssr ./bootstrap/ssr
USER node
EXPOSE 13714
CMD ["sh", "-c", "node bootstrap/ssr/ssr.*js"]
